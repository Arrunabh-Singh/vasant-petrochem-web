{
  "name": "vasant-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare-assets": "node scripts/prepare.mjs",
    "dev": "node scripts/prepare.mjs && astro dev",
    "build": "node scripts/prepare.mjs && astro build && node scripts/postbuild.mjs",
    "preview": "wrangler dev --port 4321",
    "typecheck": "astro check",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"tests/unit/*.test.ts\"",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && node scripts/checks.mjs",
    "shots": "node scripts/shots.mjs",
    "kit": "node scripts/kit.mjs",
    "content:schema": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/schemas.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "14.3.3",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "pagefind": "1.5.2",
    "satori": "0.35.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
