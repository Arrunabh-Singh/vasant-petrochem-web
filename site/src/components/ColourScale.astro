---
/**
 * The colour scale: every grade's illustrated colour, lightest to darkest
 * (lib/drop.ts byColour). Decoration beside text that names the grades; with
 * `current`, that grade's swatch is marked and its code shown under it.
 */
import type { ProductEntry } from "../lib/catalog.ts";
import { t } from "../lib/ui.ts";

interface Props {
  grades: ProductEntry[];
  current?: string;
}
const { grades, current } = Astro.props;
---
<div class="vp-scale" aria-hidden="true">
  <span class="vp-scale-end">{t("scale.lighter")}</span>
  <ol class="vp-scale-swatches">
    {
      grades.map((p) => (
        <li class:list={["vp-swatch", { "is-current": p.id === current }]} data-tint={p.data.tint}>
          {p.id === current && <span class="vp-swatch-code">{p.data.code}</span>}
        </li>
      ))
    }
  </ol>
  <span class="vp-scale-end">{t("scale.darker")}</span>
  <span class="vp-scale-marker"></span>
</div>
