---
import Base from "../../layouts/Base.astro";
import { liveInsights, page } from "../../lib/page.ts";

const copy = await page("insights");
const posts = await liveInsights();
const date = (d: Date) => d.toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" });
---
<Base title={copy.title} description={copy.description} noindex={posts.length === 0}>
  <section class="vp-hero" aria-labelledby="ins-title">
    <div class="vp-container">
      <h1 class="vp-h-page" id="ins-title">{copy.headline}</h1>
      <p class="vp-lead">{copy.lead}</p>
    </div>
  </section>
  <section class="vp-section-tight">
    <div class="vp-container">
      {posts.length > 0 ? (
        <ul class="vp-grid" role="list">
          {posts.map((p) => (
            <li class="vp-card">
              <p class="vp-card-family"><time datetime={p.data.date.toISOString()}>{date(p.data.date)}</time></p>
              <h2 class="vp-card-title"><a href={`/insights/${p.id}`}>{p.data.title}</a></h2>
              <p class="vp-card-desc">{p.data.summary}</p>
            </li>
          ))}
        </ul>
      ) : (
        <div class="vp-empty"><p class="vp-small">The first notes are on their way. Meanwhile, the marketplace lists every grade with its typical properties.</p><a class="vp-btn vp-btn-secondary" href="/marketplace">Browse the marketplace</a></div>
      )}
    </div>
  </section>
</Base>
