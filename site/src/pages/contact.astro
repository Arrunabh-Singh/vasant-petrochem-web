---
import Base from "../layouts/Base.astro";
import Field from "../components/Field.astro";
import FormGuard from "../components/FormGuard.astro";
import FormStatus from "../components/FormStatus.astro";
import Icon from "../components/Icon.astro";
import { addressLine, company, salesEmail, whatsappHref } from "../lib/company.ts";
import { page } from "../lib/page.ts";
import { localBusiness } from "../lib/seo.ts";
import { t } from "../lib/ui.ts";

const copy = await page("contact");
const types = [
  { value: "quote", label: "A price quote" },
  { value: "sample", label: "A sample" },
  { value: "document", label: "Technical or safety documents" },
  { value: "supplier", label: "Supplying to Vasant Petrochem" },
  { value: "general", label: "Something else" },
];
const map = `https://www.google.com/maps/search/?api=1&query=${company.works.lat},${company.works.lng}`;
---
<Base title={copy.title} description={copy.description} structured={[localBusiness()]}>
  <section class="vp-section-tight">
    <div class="vp-container vp-split">
      <form class="vp-form" method="post" action="/api/rfq" data-vp-form aria-labelledby="contact-title">
        <div class="vp-stack">
          <h1 class="vp-h-page" id="contact-title">{copy.headline}</h1>
          <p class="vp-small">{copy.lead}</p>
        </div>
        <Field name="type" label="What is it about?" type="select" options={types} value="quote" required />
        <div class="vp-form-row">
          <Field name="name" label="Your name" required autocomplete="name" maxlength={120} />
          <Field name="company" label="Company" autocomplete="organization" maxlength={160} />
        </div>
        <div class="vp-form-row">
          <Field name="email" label="Work email" type="email" required autocomplete="email" maxlength={254} />
          <Field name="phone" label="Phone or WhatsApp" type="tel" autocomplete="tel" maxlength={20} />
        </div>
        <Field name="message" label="Message" type="textarea" required maxlength={2000} />
        <FormGuard id="contact" />
        <FormStatus />
        <p class="vp-caption">We use these details only to reply to your enquiry.</p>
        <button class="vp-btn vp-btn-primary vp-btn-touch" type="submit">{t("cta.send")}</button>
      </form>

      <aside class="vp-stack" aria-label="Other ways to reach us">
        <div class="vp-panel">
          <h2 class="vp-h-title">Call or message</h2>
          <div class="vp-actions">
            <a class="vp-btn vp-btn-secondary" href={company.phone.href}><Icon name="phone" />{company.phone.display}</a>
            <a class="vp-btn vp-btn-secondary" href={whatsappHref(`Hello ${company.tradeName}, I would like to discuss a requirement.`)} target="_blank" rel="noopener"><Icon name="whatsapp" />{t("cta.whatsapp")}</a>
          </div>
          <p class="vp-small">{company.hours.label}</p>
        </div>
        <div class="vp-panel">
          <h2 class="vp-h-title">Write</h2>
          <p><a href={`mailto:${salesEmail}`}>{salesEmail}</a></p>
        </div>
        <div class="vp-panel">
          <h2 class="vp-h-title">Visit</h2>
          <address class="vp-small">{addressLine}</address>
          <a class="vp-link" href={map} target="_blank" rel="noopener">Open in maps <Icon name="arrow" size={16} /></a>
        </div>
      </aside>
    </div>
  </section>
</Base>
<script>
  import "../islands/form.ts";
</script>
