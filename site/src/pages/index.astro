---
/**
 * The home page as a film (design-system/README.md, "Motion"): the hero; the
 * drop is held to the light as it passes along the colour scale, darkest grade
 * to lightest, so the scroll ends in light; the company in its own words; the
 * road from Mangaliya; "Want more?", a sentence that names the doors into the
 * site and a ring of them to turn; the gold close. Every scene is a
 * finished still section first; styles/film.css pins and plays them where
 * scroll-driven animations exist and motion is welcome.
 */
import Base from "../layouts/Base.astro";
import ColourScale from "../components/ColourScale.astro";
import Drop from "../components/Drop.astro";
import Icon from "../components/Icon.astro";
import Intro from "../components/Intro.astro";
import LiquidDrop from "../components/LiquidDrop.astro";
import { getProducts, keySpecs, specText } from "../lib/catalog.ts";
import { company, whatsappHref } from "../lib/company.ts";
import { byColour } from "../lib/drop.ts";
import type { IconName } from "../lib/icons.ts";
import { itemText, page } from "../lib/page.ts";
import { localBusiness } from "../lib/seo.ts";
import { t } from "../lib/ui.ts";
import "../styles/film.css";

const home = await page("home");
const b = home.blocks;
const products = await getProducts();
const grades = byColour(products);
const texts = (items: { title: string; body?: string | undefined; claim?: string | undefined }[] = []) =>
  Promise.all(items.map(async (i) => ({ title: i.title, text: await itemText(i) })));
const how = await texts(b.how?.items);
const statement = (await texts(b.statement?.items)).map((i) => i.text).join(" ").split(/\s+/);
const place = `${company.works.street.split(", ").at(-1)}, ${company.works.city}`;

/** Each door's mark and the colour of its light, by where it leads. */
const looks: Record<string, { tint: string; icon?: IconName }> = {
  "/marketplace": { tint: "amber" },
  "/marketplace/offers": { tint: "live" },
  "/industries": { tint: "brown", icon: "factory" },
  "/supply": { tint: "fuel", icon: "truck" },
  "/quote": { tint: "gold" },
  whatsapp: { tint: "live", icon: "whatsapp" },
  "/documents": { tint: "straw", icon: "doc" },
  "/about": { tint: "white", icon: "building" },
};
const doors = await Promise.all(
  (b.finale?.items ?? []).map(async (d) => {
    const path = d.href ?? "/";
    return { ...d, path, text: await itemText(d), href: path === "whatsapp" ? whatsappHref(t("ring.whatsapp")) : path, look: looks[path] ?? { tint: "gold" } };
  }),
);
/** The finale's sentence, word by word; [words](href) are links to the doors, with any punctuation that follows them. */
const sentence = [...(b.finale?.body ?? "").matchAll(/\[([^\]]+)\]\(([^)]+)\)(\S*)|(\S+)/g)].map(([, text, href, after, word]) =>
  href ? { text: text ?? "", href, after, door: doors.findIndex((d) => d.path === href) } : { text: word ?? "" },
);
---
<Base title={home.title} description={home.description} fullTitle structured={[localBusiness()]}>
  <Intro slot="top" />
  <span class="vp-snap-top" aria-hidden="true"></span>

  {/* 1–2 · The hero; then the drop is held to the light and passes along the colour scale. */}
  <section class="vp-film" id="start" aria-labelledby="hero-title" data-fill-scene data-timeline="--film" data-bed>
    {/* Where you are on the page: dots on laptops, and a hairline across the top that fills as the film plays
        (inside the film, so it can follow the film's timeline; islands/film-snap.ts marks the current chapter). */}
    <nav class="vp-chapters" aria-label={t("chapters.label")}>
      <ol>
        <li><a href="#start" data-chapter="start"><span>{t("chapter.start")}</span></a></li>
        <li><a href="#grades" data-chapter="grades"><span>{t("chapter.grades")}</span></a></li>
        <li><a href="#our-word" data-chapter="our-word"><span>{t("chapter.word")}</span></a></li>
        <li><a href="#road" data-chapter="road"><span>{t("chapter.road")}</span></a></li>
        <li><a href="#explore" data-chapter="explore"><span>{t("chapter.explore")}</span></a></li>
      </ol>
      <span class="vp-chapters-fill" aria-hidden="true"></span>
    </nav>
    <div class="vp-film-stage">
      <div class="vp-film-glow" aria-hidden="true">
        {grades.map((p) => <span data-tint={p.data.tint}></span>)}
        <span class="vp-film-glow-own" data-tint="gold"></span>
      </div>

      <div class="vp-film-copy">
        <p class="vp-eyebrow">{place} · Est. {company.foundedYear}</p>
        <h1 class="vp-h-hero" id="hero-title">{home.headline}</h1>
        <p class="vp-lead">{home.lead}</p>
        <div class="vp-actions">
          <a class="vp-btn vp-btn-primary vp-btn-touch" href="/marketplace">{t("cta.browse")}<Icon name="arrow" size={18} /></a>
          {/* Phones have Get a quote in the bar below. */}
          <a class="vp-btn vp-btn-secondary vp-btn-touch vp-wide-only" href="/quote">{t("cta.quote")}</a>
        </div>
      </div>

      <div class="vp-film-drop">
        <div class="vp-film-float">
          <LiquidDrop tint="gold" fill="scroll" scale={grades.map((p) => p.data.tint)} />
          {/* Without WebGL, the film shows each grade's own drop over the last. */}
          <span class="vp-film-drops" aria-hidden="true">{grades.map((p) => <Drop tint={p.data.tint} />)}</span>
          <span class="vp-open-glint" aria-hidden="true"></span>
        </div>
        <span class="vp-open-shadow" aria-hidden="true"></span>
      </div>

      <a class="vp-film-skip" href="#our-word">{t("film.skip")}</a>
      <ColourScale grades={grades} links />
      <p class="vp-scroll-cue" aria-hidden="true">{t("film.scroll")}<span class="vp-cue-tick"></span></p>

      <div class="vp-film-scale">
        <p class="vp-eyebrow">{b.scale?.eyebrow}</p>
        <h2 class="vp-film-title" id="scale-title">{b.scale?.heading}</h2>
        <ol class="vp-oils" role="list" aria-labelledby="scale-title">
          {
            grades.map((p, i) => {
              const spec = keySpecs(p)[0];
              return (
                <li class="vp-oil" data-tint={p.data.tint}>
                  <Drop tint={p.data.tint} size="l" />
                  <p class="vp-oil-count" aria-hidden="true">{String(i + 1).padStart(2, "0")} / {String(grades.length).padStart(2, "0")}</p>
                  <h3 class="vp-oil-name">{p.data.name}</h3>
                  <p class="vp-oil-meta">
                    <span class="vp-oil-code">{p.data.code}</span>
                    {spec && <span class="vp-oil-spec">{spec.property} <span class="vp-nowrap">{specText(spec)}</span></span>}
                  </p>
                  <a class="vp-link" href={`/products/${p.id}`}>
                    {t("scale.view")}<span class="vp-sr"> {p.data.name}</span><Icon name="arrow" size={16} />
                  </a>
                </li>
              );
            })
          }
        </ol>
        <p class="vp-film-note">{t("scale.note")}</p>
      </div>
    </div>
    {/* Snap points, one flick each (styles/film.css): the drop filled, the scale's title, then each grade's held frame.
        The page's top (.vp-snap-top) is the hero's, and the statement below is the way out. */}
    <div class="vp-film-snaps" aria-hidden="true">
      <span class="vp-snap-drop"></span>
      <span class="vp-snap-title" id="grades"></span>
      <span class="vp-film-snaps-grades">{grades.map((p) => <span id={`grade-${p.id}`}></span>)}</span>
    </div>
  </section>

  {/* 3 · The company in its registered words, lit as it is read, over engraved gold line-work that rises as it is read. */}
  <section class="vp-statement vp-band-raised" id="our-word" aria-label={b.statement?.eyebrow} data-timeline="--statement">
    <div class="vp-guilloche" aria-hidden="true"></div>
    <div class="vp-container">
      <p class="vp-eyebrow">{b.statement?.eyebrow}</p>
      <p class="vp-statement-text vp-lit">
        {statement.map((w, i) => <><span class="w">{w}</span>{i < statement.length - 1 ? " " : ""}</>)}
      </p>
      <a class="vp-link" href="/about">More about us <Icon name="arrow" size={16} /></a>
    </div>
  </section>

  {/* 4 · The road: a tanker leaves Mangaliya and each step of an order lights as it passes. */}
  <section class="vp-road" id="road" aria-labelledby="how-title" data-timeline="--road">
    <div class="vp-road-stage">
      <div class="vp-container vp-road-inner">
        <div class="vp-head">
          <p class="vp-eyebrow">{b.how?.eyebrow}</p>
          <h2 class="vp-h-section" id="how-title">{b.how?.heading}</h2>
        </div>
        <div class="vp-road-track" aria-hidden="true">
          <span class="vp-road-pin"><span></span><span></span><span></span><span></span></span>
          <span class="vp-road-place">{place}</span>
          <span class="vp-road-line"></span>
          <span class="vp-road-route"></span>
          <svg class="vp-road-tanker" viewBox="0 0 120 48" focusable="false">
            <defs>
              <linearGradient id="vp-tank" x1="0" y1="8" x2="0" y2="34" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#f3f4f5" /><stop offset=".45" stop-color="#c0c2c3" /><stop offset="1" stop-color="#979797" />
              </linearGradient>
            </defs>
            <rect x="4" y="8" width="78" height="26" rx="13" fill="url(#vp-tank)" />
            <rect x="4" y="24" width="78" height="3" fill="#cfa145" />
            <path d="M30 9v24M56 9v24" stroke="#979797" stroke-width="1" />
            <path d="M84 36V16q0-4 4-4h14q4 0 6 4l5 10q1 2 1 4v6Z" fill="#246851" />
            <path d="M90 16h11q2 0 3 2l3 7H90Z" fill="#e6f0ed" />
            <rect x="2" y="33" width="112" height="3" rx="1.5" fill="#17120b" />
            <g fill="#17120b"><circle cx="18" cy="39" r="6" /><circle cx="32" cy="39" r="6" /><circle cx="70" cy="39" r="6" /><circle cx="101" cy="39" r="6" /></g>
            <g fill="#c0c2c3"><circle cx="18" cy="39" r="2.2" /><circle cx="32" cy="39" r="2.2" /><circle cx="70" cy="39" r="2.2" /><circle cx="101" cy="39" r="2.2" /></g>
          </svg>
        </div>
        <ol class="vp-road-steps">
          {how.map((s, i) => <li><span class="vp-step-n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span><h3>{s.title}</h3><p>{s.text}</p></li>)}
        </ol>
      </div>
    </div>
  </section>

  {/* 5 · Want more? A sentence names the doors into the site, each lit as it is read, and turns the ring below to it;
      then the ring is the reader's to turn. Without the island (no script, or reduced motion) the doors are a plain grid. */}
  <section class="vp-finale" id="explore" aria-labelledby="finale-title" data-timeline="--finale">
    <div class="vp-finale-light" aria-hidden="true">
      <span class="vp-finale-sun"></span>
      <span class="vp-finale-ivory"></span>
      <span class="vp-finale-tints">{doors.map((d, i) => <span class:list={[{ "is-on": i === 0 }]} data-tint={d.look.tint}></span>)}</span>
    </div>
    <div class="vp-container vp-finale-head">
      <h2 class="vp-finale-title" id="finale-title">{b.finale?.heading}</h2>
      <p class="vp-finale-text vp-lit">
        {
          sentence.map((s, i) => {
            const space = i < sentence.length - 1 ? " " : "";
            if (!s.href) return <><span class="w">{s.text}</span>{space}</>;
            const link = <a class="w" href={s.href} data-door={s.door >= 0 ? s.door : undefined}>{s.text}</a>;
            return <>{s.after ? <span class="vp-nowrap">{link}<span class="w">{s.after}</span></span> : link}{space}</>;
          })
        }
      </p>
    </div>
    <div class="vp-ring" data-ring data-at={t("ring.at")}>
      <ol class="vp-doors" aria-label={t("ring.label")}>
        {
          doors.map((d) => (
            <li class="vp-door" data-tint={d.look.tint}>
              <a href={d.href} target={d.path === "whatsapp" ? "_blank" : undefined} rel={d.path === "whatsapp" ? "noopener" : undefined}>
                <span class="vp-door-art" aria-hidden="true">
                  {d.path === "/marketplace" && <span class="vp-door-swatches">{grades.map((p) => <span data-tint={p.data.tint}></span>)}</span>}
                  {d.path === "/marketplace/offers" && <span class="vp-door-lots"><span></span><span></span><span></span></span>}
                  {d.path === "/quote" && <Drop tint="gold" size="xs" full />}
                  {d.look.icon && <Icon name={d.look.icon} size={40} stroke={1.6} />}
                </span>
                <span class="vp-door-name">{d.path === "/marketplace/offers" && <span class="vp-live-dot"></span>}{d.title}</span>
                <span class="vp-door-text">{d.text}</span>
                <span class="vp-door-cta">{d.cta}<Icon name="arrow" size={16} /></span>
              </a>
            </li>
          ))
        }
      </ol>
      <div class="vp-ring-bar">
        <button class="vp-ring-btn vp-ring-prev" type="button" data-ring-prev aria-label={t("ring.prev")}><Icon name="chevron" size={18} /></button>
        <p class="vp-ring-count">
          <span data-ring-count></span>
          <span class="vp-ring-hint vp-ring-hint-pointer">{t("ring.drag")}</span>
          <span class="vp-ring-hint vp-ring-hint-touch">{t("ring.swipe")}</span>
        </p>
        <button class="vp-ring-btn vp-ring-next" type="button" data-ring-next aria-label={t("ring.next")}><Icon name="chevron" size={18} /></button>
      </div>
      <p class="vp-sr" aria-live="polite" data-ring-live></p>
    </div>
  </section>

  {/* 6 · Close, on gold: the page's heaviest block, at its foot. */}
  <section class="vp-close vp-band-gold" aria-labelledby="cta-title">
    <div class="vp-container">
      <h2 class="vp-close-title" id="cta-title">{b.cta?.heading}</h2>
      <p class="vp-lead">{b.cta?.body}</p>
      <div class="vp-actions">
        <a class="vp-btn vp-btn-dark vp-btn-touch" href="/source">{t("cta.source")}<Icon name="arrow" size={18} /></a>
        <a class="vp-btn vp-btn-outline-dark vp-btn-touch" href="/quote">{t("cta.quote")}</a>
      </div>
    </div>
  </section>
</Base>
<script>
  import "../islands/film-focus.ts";
  import "../islands/film-snap.ts";
  import "../islands/ring.ts";
</script>
