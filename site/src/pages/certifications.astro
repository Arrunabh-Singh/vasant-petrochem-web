---
/** Only certificates actually held, with number, issuer and validity (MNC VP-CORP-004). Expired ones are not shown. */
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { liveCertifications, page } from "../lib/page.ts";

const copy = await page("certifications");
const certs = await liveCertifications();
const date = (iso: string) => new Date(iso).toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" });
---
<Base title={copy.title} description={copy.description} noindex={certs.length === 0}>
  <section class="vp-hero" aria-labelledby="cert-title">
    <div class="vp-container">
      <h1 class="vp-h-page" id="cert-title">{copy.headline}</h1>
      <p class="vp-lead">{copy.lead}</p>
    </div>
  </section>
  <section class="vp-section-tight">
    <div class="vp-container">
      {certs.length > 0 ? (
        <ul class="vp-grid" role="list">
          {certs.map((c) => (
            <li class="vp-panel">
              <h2 class="vp-h-title">{c.data.name}</h2>
              <dl class="vp-card-specs">
                <div class="vp-card-spec"><dt>Certificate</dt><dd>{c.data.number}</dd></div>
                <div class="vp-card-spec"><dt>Issued by</dt><dd>{c.data.issuer}</dd></div>
                <div class="vp-card-spec"><dt>Valid until</dt><dd>{date(c.data.validTo)}</dd></div>
              </dl>
              <a class="vp-link" href={`/documents/${c.data.file}`} download><Icon name="download" size={18} />Download the certificate</a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="vp-empty">
          <p class="vp-small">No certificates are listed yet. Ask the sales desk for the quality documents of any product.</p>
          <a class="vp-btn vp-btn-secondary" href="/contact">Contact the sales desk</a>
        </div>
      )}
    </div>
  </section>
</Base>
