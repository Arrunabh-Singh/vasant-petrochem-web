---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { company, whatsappHref } from "../lib/company.ts";
---
<Base title="Something went wrong" description="This page could not be loaded. Call or message the sales desk while we fix it." noindex>
  <section class="vp-hero" aria-labelledby="err-title">
    <div class="vp-container vp-stack vp-measure">
      <p class="vp-eyebrow">Error 500</p>
      <h1 class="vp-h-page" id="err-title">This page couldn’t load.</h1>
      <p class="vp-lead">The fault is on our side. Try again in a minute, or reach the sales desk directly.</p>
      <div class="vp-actions">
        <a class="vp-btn vp-btn-primary" href={company.phone.href}><Icon name="phone" />{company.phone.display}</a>
        <a class="vp-btn vp-btn-secondary" href={whatsappHref(`Hello ${company.tradeName}, your website showed an error. I would like to discuss a requirement.`)} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp</a>
      </div>
    </div>
  </section>
</Base>
