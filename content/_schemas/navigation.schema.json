{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "header": {
      "minItems": 2,
      "maxItems": 7,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 2,
            "maxLength": 30
          },
          "href": {
            "type": "string",
            "format": "starts_with",
            "pattern": "^\\/.*"
          }
        },
        "required": [
          "label",
          "href"
        ]
      }
    },
    "footer": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 2,
            "maxLength": 30
          },
          "links": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 40
                },
                "href": {
                  "type": "string",
                  "format": "starts_with",
                  "pattern": "^\\/.*"
                }
              },
              "required": [
                "label",
                "href"
              ]
            }
          }
        },
        "required": [
          "heading",
          "links"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "header",
    "footer"
  ]
}
