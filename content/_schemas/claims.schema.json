{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "text": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "owner-asserted",
              "retired"
            ]
          },
          "evidence": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 3,
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "decided": {
            "type": "string",
            "pattern": "^\\d{4}(?:-\\d{2}-\\d{2})?$"
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 3,
                "maxLength": 400
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "text",
          "status",
          "evidence",
          "decided",
          "note"
        ]
      }
    }
  },
  "required": [
    "claims"
  ]
}
