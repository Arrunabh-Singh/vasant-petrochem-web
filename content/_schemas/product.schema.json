{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "code": {
      "type": "string",
      "minLength": 2,
      "maxLength": 24
    },
    "family": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "discontinued"
      ]
    },
    "data": {
      "type": "string",
      "enum": [
        "placeholder",
        "verified"
      ]
    },
    "source": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tint": {
      "type": "string",
      "enum": [
        "gold",
        "straw",
        "amber",
        "brown",
        "fuel",
        "bitumen",
        "clear",
        "white"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 220
    },
    "specs": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "property": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 16
              },
              {
                "type": "null"
              }
            ]
          },
          "method": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 2,
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "property",
          "value",
          "unit",
          "method"
        ]
      }
    },
    "packaging": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          },
          "size": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "L",
                  "kL",
                  "kg",
                  "MT"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "type",
          "size",
          "unit"
        ]
      }
    },
    "applications": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 60
      }
    },
    "industries": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "documents": {
      "type": "object",
      "properties": {
        "sds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lang": {
                "type": "string",
                "pattern": "^[a-z]{2}$"
              },
              "file": {
                "type": "string",
                "minLength": 5,
                "maxLength": 200
              },
              "rev": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "required": [
              "lang",
              "file",
              "rev"
            ]
          }
        },
        "tds": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 5,
                  "maxLength": 200
                }
              },
              "required": [
                "file"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sds",
        "tds"
      ]
    },
    "hs": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}(?:\\.?\\d{2}){0,3}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "cas": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{2,7}-\\d{2}-\\d$"
        },
        {
          "type": "null"
        }
      ]
    },
    "density": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.5
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        {
          "type": "null"
        }
      ]
    },
    "faq": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 5,
            "maxLength": 160
          },
          "a": {
            "type": "string",
            "minLength": 5,
            "maxLength": 800
          }
        },
        "required": [
          "q",
          "a"
        ]
      }
    },
    "seo": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 70
        },
        "description": {
          "type": "string",
          "minLength": 20,
          "maxLength": 170
        }
      }
    }
  },
  "required": [
    "name",
    "code",
    "family",
    "status",
    "data",
    "source",
    "order",
    "tint",
    "summary",
    "specs",
    "packaging",
    "applications",
    "industries",
    "documents",
    "hs",
    "cas",
    "density",
    "origin",
    "faq"
  ]
}
