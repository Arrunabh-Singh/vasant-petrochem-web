{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 70
    },
    "description": {
      "type": "string",
      "minLength": 40,
      "maxLength": 170
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ]
    },
    "headline": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "lead": {
      "type": "string",
      "minLength": 2,
      "maxLength": 400
    },
    "blocks": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "eyebrow": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "heading": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "body": {
            "type": "string",
            "minLength": 2,
            "maxLength": 1200
          },
          "items": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 80
                },
                "body": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 600
                },
                "claim": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              },
              "required": [
                "title"
              ]
            }
          }
        }
      }
    }
  },
  "required": [
    "title",
    "description",
    "status",
    "headline"
  ]
}
