{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 110
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 220
    },
    "date": {},
    "author": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ]
    }
  },
  "required": [
    "title",
    "summary",
    "date",
    "author",
    "status"
  ]
}
