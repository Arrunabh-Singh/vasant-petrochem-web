{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ]
    },
    "icon": {
      "type": "string",
      "enum": [
        "hardhat",
        "brush",
        "factory",
        "fuel",
        "truck",
        "pill"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200
    }
  },
  "required": [
    "name",
    "order",
    "status",
    "icon",
    "summary"
  ]
}
