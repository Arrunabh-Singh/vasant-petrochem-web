{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 70
    },
    "description": {
      "type": "string",
      "minLength": 40,
      "maxLength": 170
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ]
    },
    "updated": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ]
    },
    "requires": {
      "type": "string",
      "enum": [
        "people",
        "careers-mailbox",
        "exports"
      ]
    }
  },
  "required": [
    "title",
    "description",
    "status",
    "updated"
  ]
}
