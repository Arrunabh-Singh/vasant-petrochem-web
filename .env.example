# Copy to .env.local and fill in. Never commit the filled copy — .gitignore
# already excludes .env*. Values come from Supabase Dashboard → Settings → API.
#
# This file is the naming reference the project's own conventions call for
# (CLAUDE.md §2, §8) and had been missing. Getting a name wrong here is not a
# loud failure: the site builds fine and then fails every query at runtime.

# --- Required: the app will not function without these ---
NEXT_PUBLIC_SUPABASE_URL=https://jwycpgugyapkihuikrwl.supabase.co
# NOT ..._ANON_KEY. lib/supabase/{server,public,middleware}.ts all read
# PUBLISHABLE_KEY; the anon key's value goes here under this name.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS — never expose to the browser, never prefix
# with NEXT_PUBLIC_. Used by lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Required for the daily digest cron ---
# /api/cron/daily-digest returns 401 until this is set (it reads the unacked
# security_alerts queue and pushes it to Telegram/email, so it fails closed).
# Must match the Authorization: Bearer value Vercel Cron sends.
CRON_SECRET=

# --- Optional: each feature no-ops cleanly when its vars are unset ---

# Break-glass admin allowlist, comma-separated. OR'd with public.app_users
# so a bad seed row can't lock the owner out of the only admin account.
ADMIN_ALLOWED_EMAILS=

# HMAC secret for office-box upload tickets (/api/documents/upload-ticket,
# /api/etl/upload). Without it those routes reject every ticket.
DOC_UPLOAD_TICKET_SECRET=

# HMAC secret shared with the factory edge gateway: authenticates telemetry
# ingest and signs control commands the gateway verifies before actuating.
TELEMETRY_HMAC_SECRET=

# Alerting (lib/notify.ts). Telegram and email are independent — set either,
# both, or neither.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
ALERT_EMAIL_TO=

# --- Not read by the web app ---
# tools/office-box/ (the Tally pull script that runs on the office machine)
# has its own .env, documented in tools/office-box/README.md: HUB_URL,
# HUB_UPLOAD_TICKET, TALLY_URL, TALLY_ETL_ENCRYPTION_KEY. They are not
# configured in Vercel.
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle and is
# public permanently. Only the two Supabase values above may use that prefix.
